{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeatherView",
  "version": "0.2.0-alpha.1",
  "identifier": "com.featherview.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FeatherView 轻阅",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "FeatherView Markdown",
        "description": "Markdown 文档"
      },
      {
        "ext": ["txt", "log"],
        "name": "FeatherView Text",
        "description": "纯文本文档"
      },
      {
        "ext": ["json"],
        "name": "FeatherView JSON",
        "description": "JSON 数据文件"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "FeatherView YAML",
        "description": "YAML 配置文件"
      },
      {
        "ext": ["toml"],
        "name": "FeatherView TOML",
        "description": "TOML 配置文件"
      }
    ]
  }
}
